# Port the HTTP server listens on.
PORT=8080
# Runtime environment; set to "production" to enable Gin release mode.
ENV=development

# MongoDB connection string, e.g. mongodb://localhost:27017 or an Atlas SRV URI.
MONGODB_URI=
# MongoDB database name to use.
MONGODB_DB=

# Firebase service-account credentials, individually from the service-account JSON.
# Leave all four empty on GCP / Firebase Hosting / Cloud Run to use
# Application Default Credentials automatically.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Client-facing Web API key from the Firebase Console
# (Project Settings → General → Web API key).
# Only required for the POST /auth/signin sign-in helper endpoint.
FIREBASE_WEB_API_KEY=

# Comma-separated list of allowed CORS origins, e.g. https://app.example.com,http://localhost:3000
# Defaults to "*" (any origin) if unset.
CORS_ALLOWED_ORIGINS=
